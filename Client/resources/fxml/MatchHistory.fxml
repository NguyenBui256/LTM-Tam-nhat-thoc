<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.MatchHistoryController">

    <VBox alignment="TOP_CENTER" spacing="15" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <padding>
            <Insets bottom="20" left="30" right="30" top="20" />
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="header-card">
            <padding>
                <Insets bottom="10" left="20" right="20" top="10" />
            </padding>

            <HBox styleClass="avatar-container">
                <ImageView fitHeight="50" fitWidth="50" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/user-interface.png" />
                    </image>
                </ImageView>
            </HBox>

            <Label fx:id="totalLabel" styleClass="player-name" text="Xin chào, Người chơi" />

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="backButton" styleClass="back-button" text="⟲ Quay lại" />
        </HBox>

        <Label styleClass="title" text="Lịch sử đấu" />

        <VBox alignment="CENTER" spacing="10" VBox.vgrow="ALWAYS">
            <TableView fx:id="matchTable" prefHeight="350.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="opponentColumn" text="Đối thủ" />
                    <TableColumn fx:id="resultColumn" text="Kết quả" />
                    <TableColumn fx:id="scoreOpp" text="Điểm Đ.Thủ" />
                    <TableColumn fx:id="scoreColumn" text="Điểm Bạn" />
                    <TableColumn fx:id="eloChangeColumn" prefWidth="93.60003662109375" text="Elo" />
                    <TableColumn fx:id="time" prefWidth="224.79989624023438" text="Thời gian" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <Pagination fx:id="pagination" maxPageIndicatorCount="5" pageCount="3" />

    </VBox>

    <stylesheets>
        <URL value="@../css/bg.css" />
        <URL value="@../css/MatchHistory.css" />
    </stylesheets>
</AnchorPane>
