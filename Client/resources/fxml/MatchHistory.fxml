<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.MatchHistoryController">

    <VBox alignment="TOP_CENTER" spacing="10" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="header-bar">
            <ImageView fitHeight="50" fitWidth="50">
                <image>
                    <Image url="@../images/user-interface.png" />
                </image>
            </ImageView>
            <Label fx:id="totalLabel" styleClass="player-name" text="Xin chào, " />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="backButton" styleClass="back-button" text="⟲ Quay lại" />
        </HBox>

        <VBox alignment="CENTER" spacing="10">
            <Label styleClass="title" text="Lịch sử đấu" />
        </VBox>

        <VBox alignment="CENTER" spacing="10">
            <padding>
                <Insets left="50.0" right="50.0" />
            </padding>

            <TableView fx:id="matchTable" prefHeight="350.0" style="-fx-border-color: #e0cda9; -fx-border-radius: 10; -fx-background-radius: 10; -fx-background-color: #fff8f0;" stylesheets="@../css/MatchHistory.css">
                <columns>
                    <TableColumn fx:id="opponentColumn" prefWidth="132.00000619888306" text="Đối thủ" />
                    <TableColumn fx:id="resultColumn" prefWidth="102.4000244140625" text="Kết quả" />
                    <TableColumn fx:id="scoreOpp" prefWidth="103.199951171875" text="Điểm đối thủ" />
                    <TableColumn fx:id="scoreColumn" prefWidth="113.60003662109375" text="Điểm của bạn" />
                    <TableColumn fx:id="eloChangeColumn" prefWidth="83.99996948242188" text="Elo" />
                    <TableColumn fx:id="time" prefWidth="156.7999267578125" text="Thời gian" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <Pagination fx:id="pagination" maxPageIndicatorCount="3" pageCount="3" />

        </VBox>

    </VBox>
    <stylesheets>
        <URL value="@../css/MatchHistory.css" />
        <URL value="@../css/bg.css" />
    </stylesheets>
</AnchorPane>