<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.controller.MatchHistoryController">

    <VBox alignment="TOP_CENTER" spacing="15"
          AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <padding>
            <Insets top="20" right="40" bottom="20" left="40"/>
        </padding>

        <HBox alignment="CENTER_LEFT">
            <Button fx:id="backButton" styleClass="back-button" text="⟲ Quay lại" />
        </HBox>

        <Label styleClass="title" text="Lịch sử đấu" />

        <VBox alignment="CENTER" spacing="10" VBox.vgrow="ALWAYS">
            <TableView fx:id="matchTable" prefHeight="350.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="opponentColumn" text="Đối thủ" />
                    <TableColumn fx:id="resultColumn" text="Kết quả" />
                    <TableColumn fx:id="scoreColumn" text="Điểm số" />
                    <TableColumn fx:id="eloChangeColumn" text="Thay đổi Elo" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <VBox alignment="CENTER" spacing="5">
            <Pagination fx:id="pagination" maxPageIndicatorCount="5" pageCount="1" />
            <Label fx:id="totalLabel" styleClass="footer-text" text="Tổng số trận đấu: 0" />
        </VBox>

    </VBox>

    <stylesheets>
        <URL value="@../css/bg.css" />
        <URL value="@../css/MatchHistory.css" />
    </stylesheets>
</AnchorPane>