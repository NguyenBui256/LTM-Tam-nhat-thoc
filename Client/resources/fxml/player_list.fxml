<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" stylesheets="@../css/bg.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.PlayerListController">

    <children>
        <Text fill="#992c1c" layoutX="151.0" layoutY="83.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Danh sách người chơi online">
            <font>
                <Font name="Segoe UI Bold" size="36.0" />
            </font>
        </Text>

        <TableView fx:id="playerTable" layoutX="62.4" layoutY="96.8" prefHeight="438.0" prefWidth="675.0" stylesheets="@../css/player_list.css" AnchorPane.bottomAnchor="65.0" AnchorPane.leftAnchor="62.0" AnchorPane.rightAnchor="63.0" AnchorPane.topAnchor="97.0">
            <columns>
                <TableColumn fx:id="nameColumn" prefWidth="170.0" text="Tên người chơi" />
                <TableColumn fx:id="eloColumn" prefWidth="120.0" text="Điểm Elo" />
                <TableColumn fx:id="winsColumn" prefWidth="100.0" text="Số trận thắng" />
                <TableColumn fx:id="statusColumn" prefWidth="130.0" text="Trạng thái" />
                <TableColumn fx:id="actionColumn" prefWidth="128.0" text="Hành động" />
            </columns>
        </TableView>

        <Pagination fx:id="pagination" prefHeight="35.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="250.0" AnchorPane.rightAnchor="250.0" />

        <Button fx:id="backButton" layoutX="37.0" layoutY="23.0" mnemonicParsing="false" onAction="#onBackClicked" prefHeight="26.0" prefWidth="77.0" style="-fx-background-radius: 20; -fx-background-color: pink;" text="Quay lại" />
    </children>
</AnchorPane>
