<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600" prefWidth="900" stylesheets="@../css/bg.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.LeaderboardController">



    <children>
        <VBox alignment="TOP_CENTER" spacing="15" stylesheets="@../css/leaderboard.css" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">

            <Label styleClass="title" text="Bảng Xếp Hạng" />

            <HBox alignment="CENTER" spacing="15">
                <ToggleButton fx:id="scoreTab" onAction="#onScoreTabClicked" selected="true" styleClass="tab-button" text="Theo điểm Elo">
               </ToggleButton>

                <Region HBox.hgrow="ALWAYS" />

                <TextField fx:id="searchField" prefWidth="250" promptText="Tìm kiếm người chơi..." styleClass="search-field" />

                <Button fx:id="backButton" onAction="#onBackClicked" styleClass="back-button" text="⟲ Quay lại" />
            </HBox>

            <TableView fx:id="leaderboardTable" prefHeight="380.0" prefWidth="869.0">
                <columns>
                    <TableColumn fx:id="rankColumn" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Hạng" />
                    <TableColumn fx:id="nameColumn" prefWidth="300.0" style="-fx-alignment: CENTER-LEFT;" text="Tên người chơi" />
                    <TableColumn fx:id="eloColumn" prefWidth="239.0" style="-fx-alignment: CENTER;" text="Điểm Elo" />
                    <TableColumn fx:id="winsColumn" prefWidth="240.0" style="-fx-alignment: CENTER;" text="Số trận thắng" />
                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <Pagination fx:id="pagination" maxPageIndicatorCount="5" pageCount="1" />
        </VBox>
    </children>
</AnchorPane>
