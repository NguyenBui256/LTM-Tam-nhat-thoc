<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600" prefWidth="900" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.LeaderboardController">

    <!-- 🔹 Khai báo ToggleGroup chỉ 1 lần -->
    <fx:define>
        <ToggleGroup fx:id="tabGroup" />
    </fx:define>

    <children>
        <VBox alignment="TOP_CENTER" layoutX="24.0" layoutY="30.0" prefHeight="540.0" prefWidth="851.0" spacing="10" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="25.600000000000023" AnchorPane.topAnchor="30.0">

            <!-- Tiêu đề -->
            <Label styleClass="title" text="Bảng xếp hạng" />

            <!-- Thanh điều khiển -->
            <HBox alignment="CENTER" spacing="15">

                <!-- ✅ Không có fx:id="tabGroup" ở đây -->
                <ToggleButton fx:id="scoreTab" onAction="#onScoreTabClicked" selected="true" styleClass="tab-button" text="Theo điểm Elo">
               <toggleGroup>
                  <ToggleGroup fx:id="tabGroup" />
               </toggleGroup></ToggleButton>

                <ToggleButton fx:id="winTab" onAction="#onWinTabClicked" styleClass="tab-button" text="Theo số trận thắng" toggleGroup="$tabGroup" />

                <Region HBox.hgrow="ALWAYS" />

                <TextField fx:id="searchField" promptText="Tìm kiếm người chơi..." styleClass="search-field" />

                <Button fx:id="backButton" onAction="#onBackClicked" styleClass="back-button" text="⟲ Quay lại" />
            </HBox>

            <!-- Bảng xếp hạng -->
            <TableView fx:id="leaderboardTable" prefHeight="369.0" prefWidth="869.0">
                <columns>
                    <TableColumn fx:id="rankColumn" prefWidth="100" text="Thứ hạng" />
                    <TableColumn fx:id="nameColumn" prefWidth="281.6000289916992" text="Tên người chơi" />
                    <TableColumn fx:id="eloColumn" prefWidth="247.19998168945312" text="Điểm Elo" />
                    <TableColumn fx:id="winsColumn" prefWidth="271.2000732421875" text="Số trận thắng" />
                </columns>
            </TableView>

            <!-- Phân trang -->
            <Pagination fx:id="pagination" maxPageIndicatorCount="5" pageCount="1" />

        </VBox>
    </children>
   <stylesheets>
      <URL value="@../css/bg.css" />
      <URL value="@../css/leaderboard.css" />
   </stylesheets>
</AnchorPane>
