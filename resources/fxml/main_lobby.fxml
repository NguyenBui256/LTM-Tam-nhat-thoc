<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600" prefWidth="800.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.MainLobbyController">

    <!-- Thanh trên cùng -->
    <HBox alignment="CENTER_RIGHT" prefHeight="60.0" prefWidth="900.0" spacing="20" style="-fx-background-color: rgba(255,255,255,0.85); -fx-padding: 0 20;" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0.0">
        <Label prefHeight="27.0" prefWidth="331.0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #c43c3c;" text="🎮 Trò chơi Tấm Nhặt Thóc" HBox.hgrow="ALWAYS" />
        <Label fx:id="playerInfo" style="-fx-font-size: 16px; -fx-text-fill: #333;" text="Xin chào, ..." />
    </HBox>

    <!-- Nội dung chính -->
    <HBox alignment="CENTER" spacing="30" AnchorPane.bottomAnchor="80" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="80">
        <VBox fx:id="onlineBox" alignment="CENTER" prefHeight="200.0" prefWidth="200.0" spacing="10" styleClass="menu-card">
            <Label style="-fx-font-size: 40px;" text="👥" />
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Người Chơi Online" />
            <Label style="-fx-font-size: 14px; -fx-text-fill: #666;" text="Xem danh sách người chơi đang trực tuyến và thách đấu họ trong trò chơi phân loại hạt" textAlignment="CENTER" wrapText="true" />
            <Button fx:id="btnOnline" styleClass="menu-button" text="→ Xem" />
        </VBox>

        <VBox fx:id="rankingBox" alignment="CENTER" prefHeight="200.0" prefWidth="200.0" spacing="10" styleClass="menu-card">
            <Label style="-fx-font-size: 40px;" text="🏆" />
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Bảng Xếp Hạng" />
            <Label style="-fx-font-size: 14px; -fx-text-fill: #666;" text="Khám phá những người chơi giỏi nhất và vị trí của bạn trong bảng xếp hạng toàn cầu" textAlignment="CENTER" wrapText="true" />
            <Button fx:id="btnRanking" styleClass="menu-button" text="→ Xem" />
        </VBox>

        <VBox fx:id="settingsBox" alignment="CENTER" prefHeight="200.0" prefWidth="200.0" spacing="10" styleClass="menu-card">
            <Label style="-fx-font-size: 40px;" text="⚙️" />
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Cài Đặt" />
            <Label style="-fx-font-size: 14px; -fx-text-fill: #666;" text="Tùy chỉnh trải nghiệm chơi game của bạn với các thiết lập âm thanh, hình ảnh và điều khiển" textAlignment="CENTER" wrapText="true" />
            <Button fx:id="btnSettings" styleClass="menu-button" text="→ Cài đặt" />
        </VBox>
    </HBox>

    <!-- Thanh dưới cùng -->
    <HBox alignment="CENTER_LEFT" prefHeight="40" spacing="20" style="-fx-background-color: rgba(255,255,255,0.8); -fx-padding: 0 20;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <Button fx:id="btnLogout" styleClass="logout-button" text="⏻ Đăng xuất" HBox.hgrow="ALWAYS" />
    </HBox>
   <stylesheets>
      <URL value="@../css/bg.css" />
      <URL value="@../css/main_lobby.css" />
   </stylesheets>
</AnchorPane>
